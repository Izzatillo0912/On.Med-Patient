<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/select_doctor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <androidx.cardview.widget.CardView
        android:id="@+id/doc_img_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="15dp"
        app:cardCornerRadius="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/doctor_image"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:srcCompat="@drawable/image_doctor" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/doctor_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="Abdurasul Mamajonov"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintStart_toEndOf="@+id/doc_img_card"
        app:layout_constraintTop_toTopOf="@+id/doc_img_card" />

    <TextView
        android:id="@+id/doctor_speciality_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        android:text="Reanimatolog"
        android:textColor="@color/bottom_not_selected_text_color"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/doc_img_card"
        app:layout_constraintTop_toBottomOf="@+id/doctor_name" />

    <TextView
        android:id="@+id/doctor_address"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        android:text="Farg'ona -> Toshloq"
        android:textColor="@color/bottom_not_selected_text_color"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/doc_img_card"
        app:layout_constraintTop_toBottomOf="@+id/doctor_speciality_name" />

    <ImageView
        android:id="@+id/select_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/doc_img_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/doc_img_card"
        app:srcCompat="@drawable/ic_circle" />

    <View
        android:id="@+id/divider3"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="15dp"
        android:background="@color/btn_back_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/doc_img_card" />


</androidx.constraintlayout.widget.ConstraintLayout>